# External API auth (Authorization: Bearer <token>)
BRIDGE_TOKEN=change-me

# Internal Cog→bridge webhook path segment (not exposed to clients)
WEBHOOK_SECRET=change-me

# Required for WhisperX diarization models
HUGGINGFACE_TOKEN=hf_...

# Host ports (optional)
BRIDGE_PORT=8080
COG_PORT=5000

# qwen3-asr remote backend (optional; defaults to local)
QWEN_BACKEND=local
QWEN_REMOTE_BASE_URL=http://<host>:<port>/v1
QWEN_REMOTE_MODEL=<model-name>
QWEN_REMOTE_TIMEOUT_S=300
