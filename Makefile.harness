# Harness Engineering — deterministic agent commands
# Usage: make -f Makefile.harness <target>
#
# Testing policy (strict TDD): docs/TESTING.md — RED → GREEN → REFACTOR
#   check = smoke + unittest (run after each TDD cycle)
#   ci    = check + lint + pkg-audit + harness audit (docs, openspec policy, bridge sync)

PYTHON ?= python3
RUFF ?= ruff
PIP_AUDIT ?= pip-audit

.PHONY: smoke check lint pkg-audit ci audit harness

## Fast checks (no GPU, no cog): bridge sync, compile, yaml, harness artifacts
smoke:
	$(PYTHON) scripts/check-bridge-sync.py
	$(PYTHON) -m py_compile json_sanitize.py hf_token.py model_paths.py bridge/bridge.py bridge/openai_compat.py scripts/bridge_k8s.py scripts/check-bridge-sync.py scripts/sync-bridge-to-k8s.py scripts/harness_audit.py
	$(PYTHON) scripts/harness_audit.py --smoke-only

## smoke + unit tests
check: smoke
	$(PYTHON) -m unittest discover -s tests -p 'test_*.py' -q

## Lint (ruff). Install once: uv tool install ruff (or pip install ruff).
lint:
	$(RUFF) check .

## Dependency vulnerability audit (pip-audit).
## requirements.txt contains git + --no-deps pins that pip-audit cannot resolve
## (torch==2.8.0 has no cp314 wheel on PyPI; whisperx is a git URL). The auditable
## set is the pinned subset; unpinned lines (ffmpeg-python, soundfile, librosa)
## are audited at their latest resolved version. New CVEs fail the gate; triage
## with PKG_AUDIT_IGNORE="<ID ID>" (e.g. a CVE whose fix is not yet compatible).
pkg-audit:
	@command -v $(PIP_AUDIT) >/dev/null 2>&1 || { \
		echo "SKIP pkg-audit: $(PIP_AUDIT) not on PATH (install: uv tool install pip-audit)"; exit 0; }
	@PKG_AUDIT_BIN=$(PIP_AUDIT) PKG_AUDIT_IGNORE="$$PKG_AUDIT_IGNORE PYSEC-2025-217 PYSEC-2026-2288 PYSEC-2026-2289 PYSEC-2026-2290 PYSEC-2026-3929" $(PYTHON) scripts/pkg_audit.py

## Full harness gate (CI)
ci: check lint pkg-audit
	$(PYTHON) scripts/harness_audit.py

## Entropy / docs drift audit
audit:
	$(PYTHON) scripts/harness_audit.py

harness: ci